{
	"name": "acm-template-pro-generator",
	"description": "ACM 示例模板生成器",
	"basePackage": "top.waterspo",
	"version": "1.0",
	"author": "mfjip",
	"createTime": "2025-4-12",
	"fileConfig": {
		"inputRootPath": ".source/acm-template-pro",
		"outputRootPath": "generated",
		"sourceRootPath": "Z:/IdeaProjects/code-generator/code-generator-demo-projects/acm-template-pro",
		"type": "dir",
		"files": [
			{
				"inputPath": "src/top/waterspo/acm/MainTemplate.java.ftl",
				"outputPath": "src/top/waterspo/acm/MainTemplate.java",
				"type": "file",
				"generateType": "dynamic"
			},
			{
				"inputPath": ".gitignore",
				"outputPath": ".gitignore",
				"type": "file",
				"generateType": "static"
			},
			{
				"inputPath": "README.md",
				"outputPath": "README.md",
				"type": "file",
				"generateType": "static"
			}
		]
	},
	"modelConfig": {
		"models": [
			{
				"fieldName": "loop",
				"type": "boolean",
				"description": "是否生成循环",
				"defaultValue": false,
				"abbr": "l"
			},
			{
				"fieldName": "author",
				"type": "String",
				"description": "作者注释",
				"defaultValue": "mfjip",
				"abbr": "a"
			},
			{
				"fieldName": "outputText",
				"type": "String",
				"description": "输出信息",
				"defaultValue": "sum = ",
				"abbr": "o"
			}
		]
	}
}